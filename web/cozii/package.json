{
  "name": "cozii",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/build-api.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "gen:sql": "node --experimental-strip-types scripts/gen-content-sql.ts",
    "sim:economy": "node --experimental-strip-types scripts/economy-sim.ts",
    "build:api": "node scripts/build-api.mjs",
    "test:server": "vitest run --config vitest.server.config.ts",
    "dev:online": "DB=$(bash scripts/dev/dev-db.sh) && COZII_DEV_API=1 COZII_DEV_AUTH=1 DATABASE_URL=$DB VITE_COZII_DEV_AUTH=1 vite"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "@supabase/supabase-js": "2.117.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "pg": "8.19.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "playwright-core": "1.56.1",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "esbuild": "0.28.2"
  }
}
